/* ================= LIVE LOCATION ================= */


.live-location-card {
    max-width: 850px;
    margin: auto;
    background: white;
    padding: 35px;
    border-radius: 25px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

.location-status {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.location-pulse {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #fff0f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
}

.location-status h3 {
    font-size: 22px;
}

.location-status p {
    color: #777;
}

.coordinates-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 25px;
}

.coordinates-box div {
    background: #fff7fa;
    padding: 20px;
    border-radius: 15px;
}

.coordinates-box span {
    display: block;
    font-size: 11px;
    letter-spacing: 1px;
    color: #888;
    margin-bottom: 5px;
}

.coordinates-box strong {
    font-size: 18px;
}

.location-actions {
    display: flex;
    gap: 12px;
}

.start-location {
    background: #c52b72;
    color: white;
    padding: 14px 22px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
}

.stop-location {
    background: #24202a;
    color: white;
    padding: 14px 22px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
}

.map-button {
    display: none;
    margin-top: 20px;
    text-align: center;
    background: #24202a;
    color: white;
    text-decoration: none;
    padding: 14px 20px;
    border-radius: 10px;
}

.location-note {
    max-width: 850px;
    margin: 20px auto 0;
    padding: 15px 20px;
    background: #fff0f6;
    border-radius: 12px;
    font-size: 14px;
    color: #555;
}


/* ================= SAFE PLACES ================= */

.safe-places-card {
    max-width: 850px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 25px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

.safe-place-item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px;
    margin-bottom: 15px;
    background: #fff7fa;
    border-radius: 16px;
}

.safe-place-icon {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #ffeaf3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 27px;
    flex-shrink: 0;
}

.safe-place-item h3 {
    margin-bottom: 5px;
}

.safe-place-item p {
    color: #777;
    font-size: 14px;
}

.safe-place-button {
    margin-left: auto;
    background: #c52b72;
    color: white;
    border: none;
    padding: 11px 20px;
    border-radius: 9px;
    cursor: pointer;
    font-weight: bold;
}

.safe-place-status {
    text-align: center;
    margin-top: 20px;
    color: #666;
}


/* ================= SOS SCREEN ================= */

.sos-screen {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(35, 25, 35, 0.96);
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
}

.sos-box {
    width: 100%;
    max-width: 600px;
    background: white;
    border-radius: 25px;
    padding: 35px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.sos-icon {
    font-size: 55px;
    margin-bottom: 10px;
}

.sos-box h1 {
    margin-bottom: 10px;
}

.sos-box > p {
    color: #666;
    line-height: 1.6;
}

.sos-location {
    margin: 25px 0;
    padding: 20px;
    background: #fff0f6;
    border-radius: 15px;
}

.sos-location span {
    display: block;
    font-size: 13px;
    color: #777;
    margin-bottom: 8px;
}

.sos-location strong {
    font-size: 17px;
}

.sos-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.call-112,
.sos-map {
    border: none;
    text-decoration: none;
    padding: 16px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.call-112 {
    background: #c52b72;
    color: white;
}

.sos-map {
    background: #24202a;
    color: white;
}

.sos-contacts {
    margin-top: 30px;
    text-align: left;
}

.sos-contacts h3 {
    margin-bottom: 15px;
}

.sos-contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 15px;
    margin-bottom: 10px;
    background: #f8f8f8;
    border-radius: 12px;
}

.sos-contact span {
    color: #777;
}

.sos-contact a {
    background: #c52b72;
    color: white;
    text-decoration: none;
    padding: 9px 14px;
    border-radius: 8px;
    white-space: nowrap;
}

/* ================= MOBILE ================= */

@media (max-width: 600px) {

    .coordinates-box {
        grid-template-columns: 1fr;
    }

    .location-actions {
        flex-direction: column;
    }

    .safe-place-item {
        flex-wrap: wrap;
    }

    .safe-place-button {
        width: 100%;
        margin-left: 0;
    }

    .sos-box {
        padding: 25px 18px;
    }

    .sos-buttons {
        grid-template-columns: 1fr;
    }

    .sos-contact {
        flex-direction: column;
        align-items: flex-start;
    }
/* ================= SAFETY STATUS BAR ================= */

.safety-status-bar {
    max-width: 1100px;
    margin: 25px auto 0;
    padding: 15px 20px;
    background: white;
    border-radius: 15px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    box-shadow: 0 8px 25px rgba(0,0,0,0.06);
}

.status-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.status-dot {
    width: 12px;
    height: 12px;
    background: #2eaf62;
    border-radius: 50%;
    display: inline-block;

    box-shadow: 0 0 0 5px #eaf8ef;
}

.status-left strong {
    display: block;
    font-size: 14px;
}

.status-left small {
    display: block;
    color: #777;
    margin-top: 3px;
}

.status-right {
    color: #666;
    font-size: 13px;
}

@media (max-width: 600px) {

    .safety-status-bar {
        margin: 15px;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .status-right {
        font-size: 12px;
    }
}
}